<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Code Archive - CodeVault</title>
</head>
<body>

    <h1>Code Archive</h1>

    <a href="/code/new">+ Add Code</a>

    <hr>

    <!-- Search and Filters -->
    <form action="/code" method="GET">

        <input
            type="text"
            name="search"
            placeholder="Search code..."
            value="<%= filters.search %>"
        >

        <select name="subject">
            <option value="">All Subjects</option>

            <% subjects.forEach(item => { %>
                <option
                    value="<%= item.subject %>"
                    <%= filters.subject === item.subject ? "selected" : "" %>
                >
                    <%= item.subject %>
                </option>
            <% }); %>
        </select>

        <select name="category">
            <option value="">All Categories</option>

            <% categories.forEach(item => { %>
                <option
                    value="<%= item.category %>"
                    <%= filters.category === item.category ? "selected" : "" %>
                >
                    <%= item.category %>
                </option>
            <% }); %>
        </select>

        <select name="language">
            <option value="">All Languages</option>

            <% languages.forEach(item => { %>
                <option
                    value="<%= item.language %>"
                    <%= filters.language === item.language ? "selected" : "" %>
                >
                    <%= item.language %>
                </option>
            <% }); %>
        </select>

        <button type="submit">Search / Filter</button>

        <a href="/code">Clear</a>

    </form>

    <hr>

    <% if (codeEntries.length === 0) { %>
        <p>No code matches your search or filters.</p>
    <% } %>

    <% codeEntries.forEach(entry => { %>

        <article>

            <h2><%= entry.title %></h2>

            <p>
                <strong>Subject:</strong>
                <%= entry.subject %>
            </p>

            <p>
                <strong>Category:</strong>
                <%= entry.category %>
            </p>

            <p>
                <strong>Language:</strong>
                <%= entry.language %>
            </p>

            <% if (entry.description) { %>
                <p>
                    <strong>Description:</strong>
                    <%= entry.description %>
                </p>
            <% } %>

            <% if (entry.tags) { %>
                <p>
                    <strong>Tags:</strong>
                    <%= entry.tags %>
                </p>
            <% } %>

            <% if (entry.code) { %>
                <h3>Code</h3>
                <pre><%= entry.code %></pre>
            <% } %>

            <hr>

        </article>

    <% }); %>

</body>
</html>